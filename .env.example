# Every variable at its default value: `cp .env.example .env` changes nothing.
# See the Configuration section of README.md for what each one does.

# ---------- server ----------
HOST=127.0.0.1
PORT=8765

# ---------- login ----------
# Empty password = no login page at all (the default, for a local run).
SPYDF_AUTH_USER=admin
SPYDF_AUTH_PASSWORD=
SPYDF_AUTH_SECRET=
SPYDF_AUTH_TTL=43200
SPYDF_AUTH_MAX_TRIES=10
SPYDF_AUTH_LOCKOUT=300

# ---------- sessions ----------
SPYDF_MAX_UPLOAD_BYTES=209715200
SPYDF_SESSION_TTL=7200
SPYDF_MAX_SESSIONS=32

# ---------- page rendering ----------
SPYDF_RENDER_ZOOM=4.0
SPYDF_MIN_ZOOM=1.5
SPYDF_MAX_ZOOM=8.0

# ---------- redaction ----------
SPYDF_MOSAIC_BLOCKS=14
SPYDF_STRIP_HEIGHT=2.0
SPYDF_MAX_STRIPS=200
SPYDF_MASK_MAX_PX=240
SPYDF_LEAK_COVERAGE=0.15
SPYDF_RECOMPRESS_QUALITY=80

# ---------- reading the images (OCR) ----------
# The images are read one by one, as Chrome reads them: a patch laid over a scan
# is a separate object, so it is not in the bitmap the recognition sees and the
# text under it comes back readable. Longest side an image is shrunk to first.
SPYDF_OCR_MAX_SIDE=1600
# Below this confidence a fragment is noise rather than text.
SPYDF_OCR_MIN_SCORE=0.5
SPYDF_OCR_MAX_IMAGES=200
SPYDF_OCR_SNIPPET=200
# Share of a recognised fragment that must lie inside a zone before the export
# calls it a leak. Higher than SPYDF_LEAK_COVERAGE on purpose: recognition
# returns whole lines, so a heading a zone's edge merely clips still overlaps it
# by a fifth, while a fragment that really survived is covered almost entirely.
SPYDF_OCR_LEAK_COVERAGE=0.6
# 1 (the default) makes the export re-read its own images and report what is
# still legible inside a zone. Off, an image-only document is exported with
# nothing verified at all: it has no text layer for the other check to look at.
SPYDF_OCR_VERIFY=1

# ---------- opaque covers ----------
# Paint over blank paper hides nothing, so what is underneath is looked at
# before a cover is reported. These say what counts as ink rather than grain.
SPYDF_COVER_INK_DELTA=48
SPYDF_COVER_INK_RATIO=0.005
SPYDF_COVER_PROBE_PX=128
# How large the hidden area is rendered when the pane shows what a cover hides.
SPYDF_REVEAL_WIDTH=900
SPYDF_REVEAL_MAX_ZOOM=8.0

# ---------- watermark ----------
SPYDF_WATERMARK_MAX_LEN=80
SPYDF_WATERMARK_MIN_SIZE=8
SPYDF_WATERMARK_DIAGONAL_RATIO=0.78
SPYDF_WATERMARK_FONT=helv

# ---------- logging ----------
SPYDF_LOG_LEVEL=INFO
SPYDF_LOG_FILE=
SPYDF_LOG_FILE_MAX_BYTES=1048576
SPYDF_LOG_FILE_BACKUPS=3
SPYDF_LOG_FILENAMES=0
SPYDF_SID_LOG_LEN=8
SPYDF_UA_MAX_LEN=120
