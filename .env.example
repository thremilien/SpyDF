# Every variable at its default value: `cp .env.example .env` changes nothing.
# See the Configuration section of README.md for what each one does.

# ---------- server ----------
HOST=127.0.0.1
PORT=8765

# ---------- login ----------
# Empty password = no login page at all (the default, for a local run).
SPYDF_AUTH_USER=admin
SPYDF_AUTH_PASSWORD=
SPYDF_AUTH_SECRET=
SPYDF_AUTH_TTL=43200
SPYDF_AUTH_MAX_TRIES=10
SPYDF_AUTH_LOCKOUT=300

# ---------- sessions ----------
SPYDF_MAX_UPLOAD_BYTES=209715200
SPYDF_SESSION_TTL=7200
SPYDF_MAX_SESSIONS=32

# ---------- page rendering ----------
SPYDF_RENDER_ZOOM=4.0
SPYDF_MIN_ZOOM=1.5
SPYDF_MAX_ZOOM=8.0

# ---------- redaction ----------
# Width of a pixelated zone, in "big pixels": the zone is rendered that coarse
# and painted back into the page bitmap.
SPYDF_MOSAIC_BLOCKS=14

# ---------- export ----------
# Every page is rendered flat and written back as an image, which is what makes
# an export carry nothing but its pixels: no text layer, no annotation, no
# structure tree, no image stream of the original. The resolution is therefore
# both the quality of the result and what the OCR is given to re-index it.
SPYDF_EXPORT_DPI=200
# JPEG quality of the flattened pages; 0 keeps them lossless, at five or six
# times the size on a scan.
SPYDF_EXPORT_JPEG_QUALITY=80

# ---------- re-indexing the pages (OCR) ----------
# The flattened pages are read back and the recognised text is laid over them as
# invisible ink, so the exported document stays searchable. Longest side a page
# bitmap is shrunk to before recognition.
SPYDF_OCR_MAX_SIDE=2400
# Below this confidence a fragment is noise rather than text.
SPYDF_OCR_MIN_SCORE=0.5
# How many pages are read at most; beyond it the export still succeeds and
# reports itself partially indexed.
SPYDF_OCR_MAX_PAGES=100
SPYDF_OCR_SNIPPET=200

# ---------- watermark ----------
SPYDF_WATERMARK_MAX_LEN=80
SPYDF_WATERMARK_MIN_SIZE=8
SPYDF_WATERMARK_DIAGONAL_RATIO=0.78
SPYDF_WATERMARK_FONT=helv

# ---------- logging ----------
SPYDF_LOG_LEVEL=INFO
SPYDF_LOG_FILE=
SPYDF_LOG_FILE_MAX_BYTES=1048576
SPYDF_LOG_FILE_BACKUPS=3
SPYDF_LOG_FILENAMES=0
SPYDF_SID_LOG_LEN=8
SPYDF_UA_MAX_LEN=120
