# SpyDF settings. Copy to .env and edit — every line below is the default, so
# an empty .env behaves exactly like no .env at all.
#
#   cp .env.example .env
#
# A real environment variable always wins over this file, so a container's
# `environment:` block keeps priority.

# ---------- server ----------
HOST=127.0.0.1
PORT=8765

# ---------- sessions ----------
# Documents live in memory only. Upload cap in bytes (200 MB), how long a
# forgotten session may sit in RAM (seconds), and how many are kept at once.
SPYDF_MAX_UPLOAD_BYTES=209715200
SPYDF_SESSION_TTL=7200
SPYDF_MAX_SESSIONS=32

# ---------- page rendering ----------
# Zoom used when the client asks for no width, and the bounds applied when it
# does. MAX_ZOOM is a memory guard rail: 8x on A4 is ~128 Mpx.
SPYDF_RENDER_ZOOM=4.0
SPYDF_MIN_ZOOM=1.5
SPYDF_MAX_ZOOM=8.0

# ---------- redaction ----------
# MOSAIC_BLOCKS is the width of a pixelated zone in "big pixels" — lower is
# coarser and less readable. STRIP_HEIGHT is the height of one redaction strip
# in PDF points, MAX_STRIPS caps how many a single zone may produce, and
# MASK_MAX_PX the resolution of the mask clipping a mosaic to its outline.
# LEAK_COVERAGE is the share of a word inside a zone above which the export
# reports it as a leak.
SPYDF_MOSAIC_BLOCKS=14
SPYDF_STRIP_HEIGHT=2.0
SPYDF_MAX_STRIPS=200
SPYDF_MASK_MAX_PX=240
SPYDF_LEAK_COVERAGE=0.15

# ---------- watermark ----------
# DIAGONAL_RATIO is the share of the page diagonal the text aims to span; it is
# only an aim, since the text is also clamped to fit inside the page. The font
# must be one PyMuPDF resolves without a font file (base-14).
SPYDF_WATERMARK_MAX_LEN=80
SPYDF_WATERMARK_MIN_SIZE=8
SPYDF_WATERMARK_DIAGONAL_RATIO=0.78
SPYDF_WATERMARK_FONT=helv

# ---------- logging ----------
# Connection, import and export are logged to stderr. Set SPYDF_LOG_FILE to
# also write a rotating file.
SPYDF_LOG_LEVEL=INFO
SPYDF_LOG_FILE=
SPYDF_LOG_FILE_MAX_BYTES=1048576
SPYDF_LOG_FILE_BACKUPS=3

# An uploaded file name is identifying ("copie_jean_dupont.pdf") and is never
# logged unless you opt in here. Leak text and watermark text are never logged
# at all, at any setting.
SPYDF_LOG_FILENAMES=0

# Only this many characters of a session id ever reach a log line: the whole id
# grants access to /api/download/{key}. UA_MAX_LEN bounds the user-agent, which
# is client-supplied.
SPYDF_SID_LOG_LEN=8
SPYDF_UA_MAX_LEN=120
